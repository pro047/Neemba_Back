# serial-agent-pipeline 저장소 설정 — KEY=value, 값은 글자 그대로 (셸 확장 없음). sap doctor 로 점검.
# 엔진 기본값과 다른 것만 둔다.

# ci.yml 이 도는 검사 전부 (python 테스트, node 테스트·타입 검사). python 은 .venv 인터프리터만 쓴다.
TEST_CMDS=(cd services/python && .venv/bin/python -m pytest -q)
TEST_CMDS=(cd services/node && npm test)
TEST_CMDS=(cd services/node && npx tsc --noEmit)

# 엔진 기본 목록(첫 줄)을 그대로 두고 서비스별 의존성·러너 설정(둘째 줄)을 더한다.
# 이 키를 쓰면 기본값을 통째로 대체하므로 첫 줄을 빼면 안 된다.
PROTECTED_FILES=package.json package-lock.json pnpm-lock.yaml yarn.lock pyproject.toml requirements.txt requirements-dev.txt setup.cfg pytest.ini mypy.ini ruff.toml .ruff.toml conftest.py tests/conftest.py vitest.config.ts vitest.config.mts jest.config.js jest.config.ts tsconfig.json pubspec.yaml pubspec.lock .gitignore CLAUDE.md AGENTS.md .env .env.example
PROTECTED_FILES=services/node/package.json services/node/package-lock.json services/node/tsconfig.json services/node/.eslintrc.cjs services/python/pyproject.toml services/python/uv.lock services/python/tests/conftest.py infra/nginx/html/monitor/package.json infra/nginx/html/monitor/package-lock.json infra/nginx/html/monitor/tsconfig.json

# 엔진 기본 git 읽기 4개 + 이 저장소의 검증 명령 3개 (에이전트가 치는 형태 그대로). 한 줄로 둔다 — --allowedTools 로 그대로 넘어간다.
AGENT_TOOLS=Bash(git status:*),Bash(git diff:*),Bash(git log:*),Bash(git ls-files:*),Bash(cd services/python && .venv/bin/python -m pytest:*),Bash(cd services/node && npm test:*),Bash(cd services/node && npx tsc --noEmit:*)
