#!/usr/bin/env bash
# 가짜 claude — API를 태우지 않고 orchestrate.sh 의 게이트를 검증한다.
#
# PATH 앞에 이 파일이 든 디렉토리를 놓으면 orchestrate.sh 가 이걸 대신 부른다.
# FAKE_SCENARIO 환경변수로 에이전트의 "행동"을 흉내낸다.
#
#   ok            정상 (STATUS: DONE)
#   no_status     산출물은 쓰는데 STATUS 라인을 빼먹음
#   no_file       산출물 자체를 안 씀
#   blocked       STATUS: BLOCKED 로 올림
#   agent_error   is_error=true
#   crash         프로세스가 0이 아닌 코드로 죽음
#   crash_with_artifact  STATUS: DONE 산출물을 쓰고 사인(result 이벤트)을 남긴 뒤 죽음
#                        — 부검이 사인을 뽑고 사람 게이트를 띄워야 정상
#   crash_no_result      산출물도 result 이벤트도 없이 죽음
#                        — 부검이 "사인 확인 불가"를 정직하게 남겨야 정상
#   crash_blocked        STATUS: BLOCKED 산출물을 쓴 뒤 죽음
#                        — 막힌 이유가 사람에게 가야 정상 (exit 3, die 아님)
#   crash_swapped        다른 모델이 돌았다고 보고하며 산출물 쓰고 죽음
#                        — 죽은 경로에서도 MODEL_LOG 에 남아야 정상
#   model_swap    다른 모델이 돌았다고 보고
#   impl_fail     구현은 되는데 테스트가 깨지는 코드를 씀
#   scope_creep   설계 ALLOWED_FILES 에 없는 파일을 건드림
#   impl_protected   구현이 보호 파일(.gitignore)을 수정함 — 보호 파일 게이트가 막아야 정상
#   verify_protected 검증이 보호 파일을 고쳐 테스트를 무르게 만듦 — 같은 게이트
#   design_overwrite 구현이 승인된 DESIGN.md 를 덮어씀 — 산출물 지문 게이트가 막아야 정상
#   verify_edits_source 검증이 ALLOWED_FILES 안의 **소스**(x.txt)를 고침 — 단계별 쓰기 게이트가 막아야 정상
#   verify_edits_test   검증이 TEST_FILES 안의 테스트 파일(t.test.txt)을 씀 — 대조군, 완주해야 정상
#   impl_edits_test     구현이 TEST_FILES 안의 테스트 파일을 고침 — 같은 게이트가 막아야 정상
#   impl_edits_source   구현이 소스(x.txt)를 고침 — 대조군, 완주해야 정상
#   (FAKE_NO_TEST_FILES=1) 설계가 TEST_FILES 블록을 빼먹음 — 계약 게이트가 막아야 정상
#   (FAKE_TEST_FILES="…")  설계의 TEST_FILES 블록 내용. 기본은 빈 블록
#   (FAKE_READS="…")       설계 단계가 Read 한 것으로 스트림에 남길 파일. **미설정이면** FAKE_ALLOWED 중
#                          존재하는 파일 전부(성실한 에이전트). 빈 문자열이면 아무것도 안 읽은 에이전트.
#   프롬프트 전문은 <STAGE>.prompt.txt 로 남긴다 — 정본 주입이 실제로 들어갔는지 테스트가 본다.
#   junk_stream   스트림에 JSON 아닌 줄이 섞임 — 관용 파싱으로 완주해야 정상
#   judge_clean   판단 검증이 미확인·반박 0 으로 통과
#   judge_flagged 판단 검증이 반박을 올림 (사람 게이트가 떠야 정상)
#   judge_nocount 판단 검증이 UNVERIFIED/REFUTED 라인을 빼먹음 (게이트 위반)
#
# 단계별로 다르게 하려면 FAKE_SCENARIO_<STAGE> 를 쓴다. 예: FAKE_SCENARIO_IMPL=no_status
#
# 레이트 리밋: FAKE_RATELIMIT_MODELS="claude-fable-5-1 claude-opus-5-5" 에 든 모델로 불리면
# 시나리오와 무관하게 리밋 거부 이벤트를 흘리고 exit 1 로 죽는다. 셸이 다음 모델로
# 갈아타야 정상이다. 목록 밖 모델은 원래 시나리오대로 동작한다.

set -uo pipefail

# ── 인자에서 --model / 단계별 상한 뽑기
MODEL="unknown"; TURNS="?"; BUDGET="없음"; ADD_DIR=""; TOOLS=""
while [ $# -gt 0 ]; do
  case "$1" in
    --model)          MODEL="$2";  shift 2 ;;
    --max-turns)      TURNS="$2";  shift 2 ;;
    --max-budget-usd) BUDGET="$2"; shift 2 ;;
    --add-dir)        ADD_DIR="$ADD_DIR${ADD_DIR:+ }$2"; shift 2 ;;
    --allowedTools)   TOOLS="$2"; shift 2 ;;
    *) shift ;;
  esac
done

PROMPT="$(cat)"

# ── 프롬프트에서 산출물 경로와 단계 이름 추출
#
# 두 가지 프롬프트 형식을 다 받아야 한다:
#   1) '## 출력' 섹션을 먼저 쓰는 형식 (골격 프롬프트가 지금 이 형식이다 — 입력을 먼저
#      길게 말하면 에이전트가 그걸 산출물로 착각해 설계를 덮어쓴 실패가 있었다)
#   2) 산출물을 마지막에 말하는 형식 (옛 골격·각색된 프롬프트)
#
# 1을 먼저 찾고 없으면 2로 떨어진다. 순서 하나에 의존하면(구 버전은 tail 만 봤다)
# 형식이 다른 프롬프트가 들어오는 순간 스텁이 **입력 파일을 산출물로 오인해서**
# 무관한 케이스들이 전부 이상한 곳에서 죽는다. 실제로 판단검증 단계 추가 때 겪었다.
ARTIFACT="$(awk '/^## 출력/{f=1;next} f&&/\.pipeline\//{print;exit}' <<<"$PROMPT" \
            | grep -o '[^ `]*\.pipeline/[^ `]*/[A-Z]*\.md' | head -1)"
[ -n "$ARTIFACT" ] \
  || ARTIFACT="$(grep -o '[^ `]*\.pipeline/[^ `]*/[A-Z]*\.md' <<<"$PROMPT" | tail -1)"
STAGE="$(basename "${ARTIFACT:-UNKNOWN.md}" .md)"   # DESIGN / JUDGE / IMPL / VERIFY

# JUDGE 는 기본 시나리오가 다르다. 전역 FAKE_SCENARIO=ok 로 돌 때 judge 산출물에
# 카운트 라인이 없으면 파이프라인이 게이트 위반으로 죽어서, 무관한 케이스가 전부
# 이 단계에서 멈춘다. ok 는 'judge_clean' 과 같은 뜻으로 다룬다.
DEFAULT_SC=ok
[ "$STAGE" = "JUDGE" ] && DEFAULT_SC=judge_clean

# ── 시나리오 결정 (단계별 > 전역 > 기본)
var="FAKE_SCENARIO_${STAGE}"
SC="${!var:-${FAKE_SCENARIO:-$DEFAULT_SC}}"
[ "$STAGE" = "JUDGE" ] && [ "$SC" = "ok" ] && SC=judge_clean

# ── 받은 인자를 남긴다
# 단계마다 다른 모델·상한이 실제로 전달되는지 테스트가 확인할 근거.
# 스트림 이벤트에 싣지 않는 이유: crash 시나리오는 아무 이벤트도 안 내는데,
# 그때도 "무엇을 받고 죽었는지"는 남아야 한다. 레이트리밋 순환 때는 마지막 호출이 남는다.
if [ -n "$ARTIFACT" ]; then
  mkdir -p "$(dirname "$ARTIFACT")"
  printf 'model=%s turns=%s budget=%s\nadd_dir=%s\ntools=%s\nstage_env=%s\n' "$MODEL" "$TURNS" "$BUDGET" "$ADD_DIR" "$TOOLS" "${PIPELINE_STAGE:-}" \
    > "$(dirname "$ARTIFACT")/$STAGE.args"
  printf '%s\n' "$PROMPT" > "$(dirname "$ARTIFACT")/$STAGE.prompt.txt"
fi

# ── 레이트 리밋 거부 (시나리오보다 먼저 본다 — 모델 단위 조건이다)
for rl in ${FAKE_RATELIMIT_MODELS:-}; do
  if [ "$rl" = "$MODEL" ]; then
    cat <<EOF
{"type":"rate_limit_event","rate_limit_info":{"status":"rejected","resetsAt":0}}
{"type":"result","subtype":"error","is_error":true,"errors":["rate limited"],"result":"fake rate limit ($MODEL)","session_id":"fake-$STAGE","total_cost_usd":0,"duration_ms":10,"num_turns":0,"model":"$MODEL"}
EOF
    exit 1
  fi
done

# 설계 단계가 "읽은" 파일을 Read tool_use 이벤트로 남긴다 — 설계 읽기 게이트가 이걸 센다.
# FAKE_READS 미설정 = FAKE_ALLOWED 중 존재하는 파일 전부. 설정(빈 값 포함) = 그 목록만.
emit_reads() {
  [ "$STAGE" = "DESIGN" ] || return 0
  local list f
  if [ "${FAKE_READS+set}" = set ]; then
    list="$FAKE_READS"
  else
    list=""
    for f in ${FAKE_ALLOWED:-x.txt}; do [ -f "${ROOT:-.}/$f" ] && list="$list $f"; done
  fi
  # FAKE_READ_ROOT: file_path 의 접두사를 바꿔 /tmp vs /private/tmp 같은 경로 불일치를 흉내낸다.
  for f in $list; do
    printf '{"type":"assistant","message":{"content":[{"type":"tool_use","name":"Read","input":{"file_path":"%s/%s"}}]}}\n' "${FAKE_READ_ROOT:-${ROOT:-.}}" "$f"
  done
}

emit() {  # emit <is_error> <reported_model>
  # stream-json 은 NDJSON 이다 — 한 줄에 이벤트 하나.
  # 진행 표시가 뽑아 쓰는 assistant 이벤트를 먼저 흘리고, 마지막에 result 를 낸다.
  echo "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":\"fake $STAGE 작업 시작\"}]}}"
  emit_reads
  cat <<EOF
{"type":"assistant","message":{"content":[{"type":"tool_use","name":"Write","input":{"file_path":"$ARTIFACT"}}]}}
{"type":"result","subtype":"success","is_error":$1,"result":"fake run: $STAGE / $SC","session_id":"fake-$STAGE","total_cost_usd":0.01,"duration_ms":100,"num_turns":2,"model":"$2"}
EOF
}

write_artifact() {  # write_artifact <status-block>
  [ -n "$ARTIFACT" ] || return 0
  mkdir -p "$(dirname "$ARTIFACT")"
  {
    printf '%s\n' "$1"; echo; echo "(fake $STAGE 산출물 — 시나리오 $SC)"
    # 설계 단계는 범위 계약도 낸다. 이게 없으면 gate_scope 가 죽인다 —
    # 진짜 실행과 같은 조건이어야 나머지 케이스가 게이트를 실제로 통과한 게 된다.
    if [ "$STAGE" = "DESIGN" ]; then
      echo
      echo "ALLOWED_FILES:"
      for f in ${FAKE_ALLOWED:-x.txt}; do echo "- $f"; done
      echo
      # 단계별 쓰기 게이트가 읽는 블록. FAKE_NO_TEST_FILES=1 이면 빼먹은 설계를 흉내낸다.
      if [ "${FAKE_NO_TEST_FILES:-0}" != "1" ]; then
        echo "TEST_FILES:"
        for f in ${FAKE_TEST_FILES:-}; do echo "- $f"; done
        echo
      fi
    fi
  } > "$ARTIFACT"
}

case "$SC" in
  ok)
    write_artifact "STATUS: DONE"
    # 성실한 검증(테스트 선작성): 설계가 선언한 테스트 파일에 테스트를 쓴다. 테스트 쪽 검증 명령
    # ($RG — run-tests.sh)은 이 줄이 있고 IMPL.md 가 없으면 실패한다 = 구현 전 red.
    if [ "$STAGE" = "VERIFY" ]; then
      for f in ${FAKE_TEST_FILES:-}; do echo "(verify 가 테스트를 씀)" >> "${ROOT:-.}/$f"; done
    fi
    emit false "$MODEL" ;;

  no_status)
    write_artifact "완료했습니다! 모든 작업이 성공적으로 끝났습니다."
    emit false "$MODEL" ;;

  no_file)
    emit false "$MODEL" ;;

  blocked)
    write_artifact "STATUS: BLOCKED
BLOCKED_REASON: 인증 방식이 설계에 없음
BLOCKED_NEEDS: JWT 인지 세션 쿠키인지 결정 필요"
    emit false "$MODEL" ;;

  agent_error)
    emit true "$MODEL" ;;

  crash)
    echo "fake crash" >&2
    exit 1 ;;

  crash_with_artifact)
    # 에이전트가 산출물을 다 쓴 **뒤** 더 검증하려다 상한에 닿은 상황.
    # 실제로 2026-08-24 judge 가 이랬다 — JUDGE.md 는 완성본이었는데 셸이 버렸다.
    write_artifact "STATUS: DONE
UNVERIFIED: 0 REFUTED: 0"
    cat <<EOF
{"type":"assistant","message":{"content":[{"type":"text","text":"fake $STAGE 산출물 작성 완료"}]}}
{"type":"result","subtype":"error_max_turns","is_error":true,"errors":["Reached maximum turns"],"result":"fake crash after artifact","session_id":"fake-$STAGE","total_cost_usd":4.72,"duration_ms":100,"num_turns":41,"terminal_reason":"turns_exhausted","model":"$MODEL"}
EOF
    exit 1 ;;

  crash_blocked)
    write_artifact "STATUS: BLOCKED
BLOCKED_REASON: 예산 상한 직전에 막힘
BLOCKED_NEEDS: 스키마를 바꿔도 되는지 결정 필요"
    cat <<EOF
{"type":"result","subtype":"error_max_budget_usd","is_error":true,"errors":["Reached maximum budget"],"result":"fake crash blocked","session_id":"fake-$STAGE","total_cost_usd":5.01,"duration_ms":100,"num_turns":30,"terminal_reason":"budget_exhausted","model":"$MODEL"}
EOF
    exit 1 ;;

  crash_swapped)
    write_artifact "STATUS: DONE
UNVERIFIED: 0 REFUTED: 0"
    cat <<EOF
{"type":"result","subtype":"error_max_turns","is_error":true,"errors":["Reached maximum turns"],"result":"fake crash swapped","session_id":"fake-$STAGE","total_cost_usd":3.1,"duration_ms":100,"num_turns":41,"terminal_reason":"turns_exhausted","model":"claude-opus-4-8"}
EOF
    exit 1 ;;

  crash_no_result)
    # 스트림이 중간에 끊긴 상황. 사인이 없다는 사실 자체가 기록돼야 한다.
    echo '{"type":"assistant","message":{"content":[{"type":"text","text":"작업 중"}]}}'
    echo "fake: 스트림이 끊김" >&2
    exit 1 ;;

  model_swap)
    write_artifact "STATUS: DONE"
    emit false "claude-opus-4-8" ;;   # 요청과 다른 모델이 돈 상황

  junk_stream)
    write_artifact "STATUS: DONE
UNVERIFIED: 0 REFUTED: 0"
    # MCP 서버 경고가 NDJSON 사이에 섞인 상황 (2026-08-26 실측)
    echo '{"type":"assistant","message":{"content":[{"type":"text","text":"시작"}]}}'
    echo 'Client.listTools() called but server does not advertise tools capability'
    emit false "$MODEL" ;;

  judge_clean)
    write_artifact "STATUS: DONE
UNVERIFIED: 0 REFUTED: 0"
    emit false "$MODEL" ;;

  judge_flagged)
    write_artifact "STATUS: DONE
UNVERIFIED: 2 REFUTED: 1"
    emit false "$MODEL" ;;

  judge_nocount)
    # STATUS 는 맞는데 기계가 읽는 카운트 라인이 없다 — 게이트 2 는 통과하고
    # 판단 검증 게이트에서 죽어야 한다.
    write_artifact "STATUS: DONE"
    emit false "$MODEL" ;;

  scope_creep)
    write_artifact "STATUS: DONE"
    # 구현이 계약에 없는 파일을 만든다 — 실제로 밟았던 실패 모드다
    [ "$STAGE" = "IMPL" ] && echo "설계에 없던 파일" > "${ROOT:-.}/stray.tmp"
    emit false "$MODEL" ;;

  impl_rename)
    write_artifact "STATUS: DONE"
    # 파일을 옮기는 리팩터링. git 은 이걸 'R  old -> new' 한 줄로 뱉으므로,
    # 범위 게이트가 그 줄을 경로 하나로 자르면 'x.txt -> moved.txt' 라는 없는
    # 파일이 되어 계약을 지킨 구현이 죽는다. 테스트는 FAKE_ALLOWED 에 양쪽
    # 경로를 다 넣고 부르므로 기대 결과는 완주다.
    if [ "$STAGE" = "IMPL" ]; then
      ( cd "${ROOT:-.}" && git mv x.txt moved.txt )
    fi
    emit false "$MODEL" ;;

  impl_hangul)
    write_artifact "STATUS: DONE"
    # non-ASCII 경로. git 은 기본적으로 C-quote 해서 내보내므로
    # ("\354\203\210\355\217\264\353\215\224/…") 계약의 원문과 매치되지 않는다.
    # 테스트는 FAKE_ALLOWED 에 한글 경로를 넣고 부른다 — 기대 결과는 완주.
    if [ "$STAGE" = "IMPL" ]; then
      mkdir -p "${ROOT:-.}/새폴더" && echo "악보" > "${ROOT:-.}/새폴더/악보.txt"
    fi
    emit false "$MODEL" ;;

  impl_protected)
    write_artifact "STATUS: DONE"
    # 보호 파일을 건드린 상황. 범위 게이트를 지나 보호 게이트에서 잡히도록
    # 테스트는 FAKE_ALLOWED 에 .gitignore 를 넣어 부른다.
    [ "$STAGE" = "IMPL" ] && echo "node_modules/" >> "${ROOT:-.}/.gitignore"
    emit false "$MODEL" ;;

  verify_protected)
    write_artifact "STATUS: DONE"
    [ "$STAGE" = "VERIFY" ] && echo "coverage/" >> "${ROOT:-.}/.gitignore"
    emit false "$MODEL" ;;

  design_overwrite)
    write_artifact "STATUS: DONE"
    # 구현이 입력 파일을 산출물로 착각해 덮어쓰는 실패 모드 (design-notes §6)
    [ "$STAGE" = "IMPL" ] && echo "(impl 이 덧붙임)" >> "$(dirname "$ARTIFACT")/DESIGN.md"
    emit false "$MODEL" ;;

  verify_edits_source)
    write_artifact "STATUS: DONE"
    # 검증이 테스트를 통과시키려고 소스를 땜질하는 실패 모드. x.txt 는 ALLOWED_FILES 안에
    # 있으므로 범위 게이트는 통과한다 — 단계별 쓰기 게이트만이 잡을 수 있다.
    [ "$STAGE" = "VERIFY" ] && echo "(verify 가 소스를 고침)" >> "${ROOT:-.}/x.txt"
    emit false "$MODEL" ;;

  verify_edits_test)
    write_artifact "STATUS: DONE"
    [ "$STAGE" = "VERIFY" ] && echo "(verify 가 테스트를 씀)" >> "${ROOT:-.}/t.test.txt"
    emit false "$MODEL" ;;

  impl_edits_test)
    write_artifact "STATUS: DONE"
    # 구현이 기존 테스트를 고쳐 통과시키는 실패 모드 (impl.md 가 "가장 나쁜 실패 모드"라 부르는 것)
    [ "$STAGE" = "IMPL" ] && echo "(impl 이 테스트를 고침)" >> "${ROOT:-.}/t.test.txt"
    emit false "$MODEL" ;;

  impl_edits_source)
    write_artifact "STATUS: DONE"
    [ "$STAGE" = "IMPL" ] && echo "(impl 이 소스를 고침)" >> "${ROOT:-.}/x.txt"
    emit false "$MODEL" ;;

  impl_fail)
    write_artifact "STATUS: DONE"
    # 테스트를 깨뜨릴 흔적을 남긴다 (테스트 스크립트가 이 파일을 본다)
    [ "$STAGE" = "IMPL" ] && touch "$(dirname "$ARTIFACT")/BROKEN"
    emit false "$MODEL" ;;

  *)
    echo "알 수 없는 시나리오: $SC" >&2
    exit 99 ;;
esac
