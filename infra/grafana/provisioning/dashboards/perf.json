      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "오디오 입력 이상 (5m 증분)",
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "increase(neemba_ffmpeg_stale_total[5m])",
          "legendFormat": "ffmpeg stale"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "sum(neemba_stt_paused)",
